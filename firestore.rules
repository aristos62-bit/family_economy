rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 🔐 USERS ROOT DOCUMENT
    match /users/{userId} {
      // ✅ Προσθήκη ελέγχου userId != "" για αποφυγή denials κατά το initialization της εφαρμογής
      allow read, create, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";

      // SEC-006b: νέο doc σε υποσυλλογή μόνο όταν το root doc υπάρχει και δεν
      // είναι σημασμένο για διαγραφή. Τα delete μένουν ελεύθερα ώστε να τρέχει
      // το cascade (εκείνη τη στιγμή ο marker είναι `deleted:true`).
      // Μόνο στα create: τα updates σε διαγραμμένα docs αποτυγχάνουν με
      // not-found και τα batched writes έχουν όριο 20 access calls.
      function parentActive() {
        return exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId))
               .data.get('deleted', false) != true;
      }

      // ✅ TAGS
      match /tags/{tagId} {
        allow read, update, delete:
          if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ ACCOUNTS
      match /accounts/{accountId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ CATEGORIES & SUBCATEGORIES (Βελτιωμένο με recursive wildcard)
      match /categories/{categoryId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();

        // ✅ Καλύπτει τις subcategories και οποιαδήποτε άλλη υπο-συλλογή
        match /{allSubcollections=**} {
          allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
          allow create:
            if isSignedIn() && request.auth.uid == userId && userId != ""
               && parentActive();
        }
      }

      // ✅ TRANSACTIONS
      match /transactions/{transactionId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ BUDGETS
      match /budgets/{budgetId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ NOTIFICATIONS
      match /notifications/{notificationId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ TRANSACTION SPLITS
      match /transaction_splits/{splitId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ TRANSACTION TAGS
      match /transaction_tags/{tagLinkId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ ATTACHMENTS
      match /attachments/{attachmentId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ ACCOUNT SNAPSHOTS
      match /account_snapshots/{snapshotId} {
        allow read, update, delete: if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ SETTINGS
      match /settings/{settingId} {
        allow read, delete:
          if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create, update:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }

      // ✅ OIL PURCHASES
      match /oil_purchases/{purchaseId} {
        allow read, update, delete:
          if isSignedIn() && request.auth.uid == userId && userId != "";
        allow create:
          if isSignedIn() && request.auth.uid == userId && userId != ""
             && parentActive();
      }
    }

    // ✅ EXCHANGE RATES (read-only για όλους)
    match /exchange_rates/{rateId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
